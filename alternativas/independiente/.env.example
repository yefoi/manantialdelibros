# Copia este archivo a .env en la raíz del repositorio.
COMPOSE_PROJECT_NAME=manantial-independiente
CLOUD_PROVIDER=independiente
DATA_DIR=.nube-datos/independiente
PORT=8080
PUBLIC_URL=http://localhost:8080
# En el alojamiento: NODE_ENV=production y PUBLIC_URL=https://tu-dominio
NODE_ENV=development
ADMIN_USER=biblioteca
ADMIN_PASSWORD=
SESSION_SECRET=
SYNC_SECONDS=60
TRUST_PROXY=false
