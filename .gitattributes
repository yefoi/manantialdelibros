# Normalización de finales de línea
* text=auto

# Archivos de Windows: siempre CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.txt  text eol=crlf

# Web: siempre LF
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Binarios
*.png  binary
*.jpg  binary
*.ico  binary
*.woff2 binary
*.docx binary
